{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "regulated-infinity-web",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/pulserail/*",
      "/privacy/*",
      "/accessibility/*"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
